<?xml version="1.0" encoding="utf-8"?>
<!-- Rules for Android 12+ (API 31+). Workly stores everything locally, so the
     database and preferences are included in cloud backup / device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore" />
        <include
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore" />
        <include
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
