<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Workly ships. Declaring them here is what makes the app appear in
  the system "App language" screen on Android 13+, and it keeps the in-app picker
  and the system settings in step.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ja" />
    <locale android:name="zh-Hans" />
</locale-config>
