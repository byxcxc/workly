<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light/dark window chrome comes from the DayNight parent; the Compose theme
      paints everything else. This XML theme exists so the window background is
      right before the first frame is drawn, and so AppCompatActivity (which is
      what AppCompat needs for per-app language) has a valid theme.
    -->
    <style name="Theme.Workly" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
