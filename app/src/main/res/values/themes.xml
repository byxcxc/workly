<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme shell. Colors are driven by the Compose Material 3 theme;
         this XML theme only prevents a white/black flash before Compose draws. -->
    <style name="Theme.Workly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
